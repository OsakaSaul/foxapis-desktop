{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for FoxAPIs Desktop v0.1",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "fs:allow-home-read",
    "fs:allow-home-write",
    "fs:allow-config-read",
    "fs:allow-config-write",
    "store:default",
    "os:default",
    "updater:default",
    "autostart:default"
  ]
}
